  m_Script: {fileID: 11500000, guid: a71d9fcd991795d4db1e0624d16dab9f, type: 3}
  m_Name: T_2
  m_EditorClassIdentifier: 
  _simplifiedChinese: "\u6309\u4E0B\u7A7A\u683C\u952E\u4EE5\u4FDD\u6301\u4E0A\u4E00\u6B21\u79FB\u52A8\u7684\u60EF\u6027\u3002\n\u8FD9\u53EF\u4EE5\u8282\u7701\u80FD\u91CF\u3002"
  _english: 'Press Space to keep the inertia of your last movement.

    This allows
    you to save energy.'
  _russian: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u043E\u0431\u0435\u043B,
    \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0438\u043D\u0435\u0440\u0446\u0438\u044E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\n\u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u044D\u043D\u0435\u0440\u0433\u0438\u044E."
  _spanish: "Pulsa la barra espaciadora para conservar la inercia del \xFAltimo movimiento.\nEsto
    permite ahorrar energ\xEDa."
  _breazilian: "Pressione a barra de espa\xE7o para manter a in\xE9rcia do \xFAltimo
    movimento.\nIsso permite economizar energia."
  _german: "Dr\xFCcke die Leertaste, um die Tr\xE4gheit der letzten Bewegung beizubehalten.\nSo
    kannst du Energie sparen."
  _french: "Appuyez sur espace pour conserver l'inertie du dernier mouvement.\r\nCela
    permet d'\xE9conomiser de l'\xE9nergie"
  _turkish: "Son hareketin ivmesini korumak i\xE7in bo\u015Fluk tu\u015Funa bas\u0131n.\nBu,
    enerji tasarrufu yapman\u0131z\u0131 sa\u011Flar."
  _japanese: "\u30B9\u30DA\u30FC\u30B9\u30AD\u30FC\u3092\u62BC\u3059\u3068\u3001\u76F4\u524D\u306E\u79FB\u52D5\u306E\u6163\u6027\u3092\u7DAD\u6301\u3057\u307E\u3059\u3002\n\u3053\u308C\u306B\u3088\u308A\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u7BC0\u7D04\u3067\u304D\u307E\u3059\u3002"
  _polish: "Naci\u015Bnij spacj\u0119, aby zachowa\u0107 bezw\u0142adno\u015B\u0107
    ostatniego ruchu.\nPozwala to oszcz\u0119dza\u0107 energi\u0119."
  _traditionnalChinese: "\u6309\u4E0B\u7A7A\u767D\u9375\u4EE5\u4FDD\u7559\u4E0A\u4E00\u6B21\u79FB\u52D5\u7684\u6163\u6027\u3002\n\u9019\u53EF\u4EE5\u7BC0\u7701\u80FD\u91CF\u3002"
  _italian: "Premi la barra spaziatrice per mantenere l\u2019inerzia dell\u2019ultimo
    movimento.\nQuesto consente di risparmiare energia."
